# Polygon Edge (systemd) — one unit per host; role is chosen via /etc/default/polygon-edge.
#
# 1) Copy this file:
#    sudo cp /home/ubuntu/ucl-src/scripts/aws-ibft/polygon-edge.service /etc/systemd/system/
# 2) Install environment (ROLE + JSON-RPC bind):
#    sudo cp /home/ubuntu/ucl-src/scripts/aws-ibft/polygon-edge.default.example /etc/default/polygon-edge
#    sudo nano /etc/default/polygon-edge
#    Set ROLE=validator-N | fullnode-N | rpc-N
#    On RPC nodes set JSONRPC_BIND=0.0.0.0; elsewhere keep JSONRPC_BIND=127.0.0.1 unless you know you need wider exposure.
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now polygon-edge
#
# Binary: build at /home/ubuntu/ucl-src/polygon-edge after rsync.
#   sudo chown -R ubuntu:ubuntu /home/ubuntu/ucl-src

[Unit]
Description=Polygon Edge
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# Defaults if /etc/default/polygon-edge is missing (override there per host).
Environment=UCL_BASE=/home/ubuntu/ucl-src/aws-ibft-out
Environment=ROLE=validator-1
Environment=JSONRPC_BIND=127.0.0.1

EnvironmentFile=-/etc/default/polygon-edge

# systemd requires WorkingDirectory= to be a literal absolute path; it does not
# expand ${...} there the way ExecStart arguments do.
WorkingDirectory=/home/ubuntu/ucl-src
ExecStart=/home/ubuntu/ucl-src/polygon-edge server \
  --data-dir ${UCL_BASE}/${ROLE} \
  --chain ${UCL_BASE}/genesis.json \
  --libp2p 0.0.0.0:10002 \
  --grpc-address 127.0.0.1:9632 \
  --jsonrpc ${JSONRPC_BIND}:8545 \
  --num-block-confirmations 2
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
