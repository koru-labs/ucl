# Used by genesis-from-manifest.sh (default --manifest). Copy to customize.
#
# Bootnodes: either set BOOTNODE_1 .. BOOTNODE_N below (full multiaddrs), OR omit them
# and pass repeated --bootnode-ip / --bootnode-dns flags to genesis-from-manifest.sh
# (Node IDs come from fullnode-* dirs in numeric order).

CHAIN_ID=51001
CHAIN_NAME=aws-ibft-dev
EPOCH_SIZE=10
BLOCK_TIME=2s
BLOCK_GAS_LIMIT=10000000
# Leave unset for CLI default EIP-1559 genesis params, or set e.g. 1000000000:2:8
# BASE_FEE_CONFIG=

# IBFT PoA (omit --pos)
IBFT_VALIDATOR_TYPE=bls

# At least two bootnodes are recommended. Keep these on fullnode-*,
# not on rpc-* hosts. Add BOOTNODE_3, BOOTNODE_4, ... as needed.
BOOTNODE_1=/dns4/fullnode-1.example.internal/tcp/10002/p2p/REPLACE_WITH_FULLNODE1_NODE_ID
BOOTNODE_2=/dns4/fullnode-2.example.internal/tcp/10002/p2p/REPLACE_WITH_FULLNODE2_NODE_ID

# Premines: PREMINE_0 .. PREMINE_N (optional). Validator ECDSA addresses are premined automatically
# with PREMINE_VALIDATOR_WEI unless already listed below (or set INCLUDE_VALIDATOR_PREMINE=0).
PREMINE_0=0x0000000000000000000000000000000000000000:1000000000000000000000
# Optional: explicit validator premines (same as auto-include); use auto:validator-N
# PREMINE_1=auto:validator-1
# PREMINE_2=auto:validator-2

# Wei for default validator premines and auto:validator-* lines
PREMINE_VALIDATOR_WEI=1000000000000000000000000
# INCLUDE_VALIDATOR_PREMINE=0

# Optional IBFT extras
# REWARD_WALLET=0xDEADBEEF00000000000000000000000000000000:1000000
BURN_CONTRACT=0:0x0000000000000000000000000000000000000000
